\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces CATCH training and inference. Haar transforms produce eight subbands; noisy target, voided-input, and signed-mask channels form the 17-channel WavUNet input. Predictions are inverse-transformed and hard-composited. Random and weighted models average five case-stable trajectories from one EMA checkpoint; fixed mask uses $N=1$. Thumbnails were selected without reconstruction metrics.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:catch-architecture}{{1}{3}{CATCH training and inference. Haar transforms produce eight subbands; noisy target, voided-input, and signed-mask channels form the 17-channel WavUNet input. Predictions are inverse-transformed and hard-composited. Random and weighted models average five case-stable trajectories from one EMA checkpoint; fixed mask uses $N=1$. Thumbnails were selected without reconstruction metrics}{figure.1}{}}
