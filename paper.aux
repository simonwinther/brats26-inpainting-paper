\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Raw five-case EMA checkpoint diagnostics without dashboard smoothing. Stars mark the retained checkpoint after ranking aggregate SSIM, PSNR, and MSE; fixed-mask 170k and 180k tie in average rank, with 180k retained because it leads PSNR and MSE. Each point uses one deterministic 1000-step trajectory. Curves are selection diagnostics, not confirmation results.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:checkpoint-selection}{{2}{7}{Raw five-case EMA checkpoint diagnostics without dashboard smoothing. Stars mark the retained checkpoint after ranking aggregate SSIM, PSNR, and MSE; fixed-mask 170k and 180k tie in average rank, with 180k retained because it leads PSNR and MSE. Each point uses one deterministic 1000-step trajectory. Curves are selection diagnostics, not confirmation results}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Development-set joint rank at terminal EMA checkpoints (lower is better). Bold and underlining mark the lowest and second-lowest value in each numeric column; fixed-mask $N=1$ was retained as explained in the text.}}{7}{table.1}\protected@file@percent }
\newlabel{tab:ensemble-selection}{{1}{7}{Development-set joint rank at terminal EMA checkpoints (lower is better). Bold and underlining mark the lowest and second-lowest value in each numeric column; fixed-mask $N=1$ was retained as explained in the text}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Held-out 75-Case Confirmation}{7}{subsection.5.2}\protected@file@percent }
\newlabel{sec:results:confirmation}{{5.2}{7}{Held-out 75-Case Confirmation}{subsection.5.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Held-out 75-case confirmation results. Values are mean $\pm $ sample SD. Joint rank averages each pipeline's per-case SSIM, PSNR, and MSE ranks; lower is better. Bold and underlining mark the best and second-best value in each numeric column. Fixed, Random, and Weighted denote the fixed-mask, random-augmentation, and weighted-mixture pipelines. Fixed uses $N=1$, so its contrasts with the mean-$N=5$ pipelines are not compute matched.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:confirmation-results}{{2}{8}{Held-out 75-case confirmation results. Values are mean $\pm $ sample SD. Joint rank averages each pipeline's per-case SSIM, PSNR, and MSE ranks; lower is better. Bold and underlining mark the best and second-best value in each numeric column. Fixed, Random, and Weighted denote the fixed-mask, random-augmentation, and weighted-mixture pipelines. Fixed uses $N=1$, so its contrasts with the mean-$N=5$ pipelines are not compute matched}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Compute-matched paired effects of weighted-mixture versus random augmentation on all 75 confirmation cases. Positive values favor weighted mixture; each point is one case, and diamonds show the mean with the deterministic 100,000-resample case-bootstrap 95\% interval. W/L gives weighted wins/losses (no ties). MSE is plotted as a reduction, so positive is better. Both pipelines use the same five case-stable trajectories and voxel-wise mean aggregation.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:confirmation-effects}{{3}{8}{Compute-matched paired effects of weighted-mixture versus random augmentation on all 75 confirmation cases. Positive values favor weighted mixture; each point is one case, and diamonds show the mean with the deterministic 100,000-resample case-bootstrap 95\% interval. W/L gives weighted wins/losses (no ties). MSE is plotted as a reduction, so positive is better. Both pipelines use the same five case-stable trajectories and voxel-wise mean aggregation}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Weighted-mixture mean-$N=5$ cases selected deterministically: nearest cohort SSIM percentiles 10 and 50, plus the upper-quintile case with the largest maximum-slice scored region. Zero-padded square panels (no resampling) show voided input, reconstruction, observed T1n, and normalized absolute error. Cyan marks the full hole; dashed yellow marks healthy voxels scored by the official metrics; reference outside yellow may contain pathology. Error is restricted to yellow on one pooled 99th-percentile-clipped scale. Bottom pairs zoom reconstruction/reference with matched row-specific windows; each row uses its maximum-area axial slice.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:qualitative-reconstructions}{{4}{9}{Weighted-mixture mean-$N=5$ cases selected deterministically: nearest cohort SSIM percentiles 10 and 50, plus the upper-quintile case with the largest maximum-slice scored region. Zero-padded square panels (no resampling) show voided input, reconstruction, observed T1n, and normalized absolute error. Cyan marks the full hole; dashed yellow marks healthy voxels scored by the official metrics; reference outside yellow may contain pathology. Error is restricted to yellow on one pooled 99th-percentile-clipped scale. Bottom pairs zoom reconstruction/reference with matched row-specific windows; each row uses its maximum-area axial slice}{figure.4}{}}
