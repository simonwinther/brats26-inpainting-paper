\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Weighted-mixture mean-$N=5$ cases at empirical SSIM quantiles 10/50/90. Columns show voided input, prediction, observed T1n, paired zooms, and normalized absolute error. Cyan denotes the full hole and dashed yellow the scored healthy region; error is shown there on a shared clipped scale. Axial slices maximize mask coverage independently of reconstruction error.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:qualitative-reconstructions}{{5}{9}{Weighted-mixture mean-$N=5$ cases at empirical SSIM quantiles 10/50/90. Columns show voided input, prediction, observed T1n, paired zooms, and normalized absolute error. Cyan denotes the full hole and dashed yellow the scored healthy region; error is shown there on a shared clipped scale. Axial slices maximize mask coverage independently of reconstruction error}{figure.5}{}}
