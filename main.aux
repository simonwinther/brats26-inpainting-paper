\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textcolor {revisionblue}{Internal 75-case training-policy selection results. Values are mean $\pm $ sample SD. Joint rank averages each pipeline's per-case SSIM, PSNR, and MSE ranks; lower is better. Bold and underlining mark the best and second-best value in each numeric column. Fixed, Random, and Weighted denote the fixed-mask, random-augmentation, and weighted-mixture pipelines. Fixed uses $N=1$, so its contrasts with the mean-$N=5$ pipelines are not compute matched.}}}{9}{table.caption.13}\protected@file@percent }
\newlabel{tab:model-selection-results}{{2}{9}{\revision {Internal 75-case training-policy selection results. Values are mean $\pm $ sample SD. Joint rank averages each pipeline's per-case SSIM, PSNR, and MSE ranks; lower is better. Bold and underlining mark the best and second-best value in each numeric column. Fixed, Random, and Weighted denote the fixed-mask, random-augmentation, and weighted-mixture pipelines. Fixed uses $N=1$, so its contrasts with the mean-$N=5$ pipelines are not compute matched.}}{table.caption.13}{}}
\citation{durrer2026fastwdm3d}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textcolor {revisionblue}{Post-hoc compute-matched sensitivity analysis on the 75-case internal model-selection set. Values are mean $\pm $ sample SD and all pipelines use voxel-wise mean aggregation with $N=5$. Joint rank averages each pipeline's per-case SSIM, PSNR, and MSE ranks; lower is better. Bold and underlining mark the best and second-best value in each numeric column. This sensitivity does not replace the frozen, development-selected comparison, in which fixed mask uses $N=1$.}}}{10}{table.caption.14}\protected@file@percent }
\newlabel{tab:fixed-n5-sensitivity}{{3}{10}{\revision {Post-hoc compute-matched sensitivity analysis on the 75-case internal model-selection set. Values are mean $\pm $ sample SD and all pipelines use voxel-wise mean aggregation with $N=5$. Joint rank averages each pipeline's per-case SSIM, PSNR, and MSE ranks; lower is better. Bold and underlining mark the best and second-best value in each numeric column. This sensitivity does not replace the frozen, development-selected comparison, in which fixed mask uses $N=1$.}}{table.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Compute-matched paired effects of weighted mixture versus random augmentation across the \textcolor {revisionblue}{75 internal model-selection cases}. Positive values favor weighted mixture. Points represent cases; diamonds show mean paired effects with 100,000-resample case-bootstrap 95\% CIs. W/L denotes wins/losses.}}{10}{figure.caption.15}\protected@file@percent }
\newlabel{fig:confirmation-effects}{{4}{10}{Compute-matched paired effects of weighted mixture versus random augmentation across the \revision {75 internal model-selection cases}. Positive values favor weighted mixture. Points represent cases; diamonds show mean paired effects with 100,000-resample case-bootstrap 95\% CIs. W/L denotes wins/losses}{figure.caption.15}{}}
