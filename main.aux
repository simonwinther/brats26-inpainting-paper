\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Five-case EMA checkpoint diagnostics. Stars mark retained checkpoints after ranking aggregate SSIM, PSNR, and MSE. Fixed-mask steps 170k and 180k tie in mean rank; step 180k is retained because it leads in PSNR and MSE. Each point uses one deterministic 1000-step trajectory; curves are \textcolor {revisionblue}{within-arm selection diagnostics, not 75-case model-selection results}.}}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:checkpoint-selection}{{3}{8}{Five-case EMA checkpoint diagnostics. Stars mark retained checkpoints after ranking aggregate SSIM, PSNR, and MSE. Fixed-mask steps 170k and 180k tie in mean rank; step 180k is retained because it leads in PSNR and MSE. Each point uses one deterministic 1000-step trajectory; curves are \revision {within-arm selection diagnostics, not 75-case model-selection results}}{figure.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Development-set joint rank at the terminal EMA states. Bold and underlining mark the lowest and second-lowest values within each arm. Fixed-mask $N=1$ was retained for the compute--performance trade-off.}}{8}{table.caption.12}\protected@file@percent }
\newlabel{tab:ensemble-selection}{{1}{8}{Development-set joint rank at the terminal EMA states. Bold and underlining mark the lowest and second-lowest values within each arm. Fixed-mask $N=1$ was retained for the compute--performance trade-off}{table.caption.12}{}}
