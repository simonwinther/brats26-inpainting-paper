\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Five-case EMA checkpoint diagnostics. Stars mark retained checkpoints after ranking aggregate SSIM, PSNR, and MSE. Fixed-mask steps 170k and 180k tie in mean rank; step 180k is retained because it leads in PSNR and MSE. Each point uses one deterministic 1000-step trajectory; curves are selection diagnostics, not confirmation results.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:checkpoint-selection}{{3}{8}{Five-case EMA checkpoint diagnostics. Stars mark retained checkpoints after ranking aggregate SSIM, PSNR, and MSE. Fixed-mask steps 170k and 180k tie in mean rank; step 180k is retained because it leads in PSNR and MSE. Each point uses one deterministic 1000-step trajectory; curves are selection diagnostics, not confirmation results}{figure.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Development-set joint rank at the terminal EMA states. Bold and underlining mark the lowest and second-lowest values within each arm. Fixed-mask $N=1$ was retained for the compute--performance trade-off.}}{8}{table.caption.11}\protected@file@percent }
\newlabel{tab:ensemble-selection}{{1}{8}{Development-set joint rank at the terminal EMA states. Bold and underlining mark the lowest and second-lowest values within each arm. Fixed-mask $N=1$ was retained for the compute--performance trade-off}{table.caption.11}{}}
\citation{durrer2026fastwdm3d}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Case-disjoint 75-case confirmation results (mean $\pm $ SD). Lower joint rank is better. Bold and underlining indicate the best and second-best results, respectively. The fixed-mask pipeline uses $N=1$ and is therefore not compute-matched to the two mean-$N=5$ pipelines.}}{9}{table.caption.12}\protected@file@percent }
\newlabel{tab:confirmation-results}{{2}{9}{Case-disjoint 75-case confirmation results (mean $\pm $ SD). Lower joint rank is better. Bold and underlining indicate the best and second-best results, respectively. The fixed-mask pipeline uses $N=1$ and is therefore not compute-matched to the two mean-$N=5$ pipelines}{table.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Compute-matched paired effects of weighted mixture versus random augmentation across 75 cases. Positive values favor weighted mixture. Points represent cases; diamonds show mean paired effects with 100,000-resample case-bootstrap 95\% CIs. W/L denotes wins/losses.}}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:confirmation-effects}{{4}{9}{Compute-matched paired effects of weighted mixture versus random augmentation across 75 cases. Positive values favor weighted mixture. Points represent cases; diamonds show mean paired effects with 100,000-resample case-bootstrap 95\% CIs. W/L denotes wins/losses}{figure.caption.13}{}}
