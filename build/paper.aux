\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Development-set joint rank at terminal EMA checkpoints (lower is better). Bold and underlining mark the lowest and second-lowest value in each numeric column; fixed-mask $N=1$ was retained as explained in the text.}}{8}{table.1}\protected@file@percent }
\newlabel{tab:ensemble-selection}{{1}{8}{Development-set joint rank at terminal EMA checkpoints (lower is better). Bold and underlining mark the lowest and second-lowest value in each numeric column; fixed-mask $N=1$ was retained as explained in the text}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Held-out 75-case confirmation results. Values are mean $\pm $ sample SD. Joint rank averages each pipeline's per-case SSIM, PSNR, and MSE ranks; lower is better. Bold and underlining mark the best and second-best value in each numeric column. Fixed, Random, and Weighted denote the fixed-mask, random-augmentation, and weighted-mixture pipelines. Fixed uses $N=1$, so its contrasts with the mean-$N=5$ pipelines are not compute matched.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:confirmation-results}{{2}{8}{Held-out 75-case confirmation results. Values are mean $\pm $ sample SD. Joint rank averages each pipeline's per-case SSIM, PSNR, and MSE ranks; lower is better. Bold and underlining mark the best and second-best value in each numeric column. Fixed, Random, and Weighted denote the fixed-mask, random-augmentation, and weighted-mixture pipelines. Fixed uses $N=1$, so its contrasts with the mean-$N=5$ pipelines are not compute matched}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Compute-matched paired effects of weighted-mixture versus random augmentation on all 75 confirmation cases. Positive values favor weighted mixture; each point is one case, and diamonds show the mean with the deterministic 100,000-resample case-bootstrap 95\% interval. W/L gives weighted wins/losses (no ties). MSE is plotted as a reduction, so positive is better. Both pipelines use the same five case-stable trajectories and voxel-wise mean aggregation.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:confirmation-effects}{{4}{9}{Compute-matched paired effects of weighted-mixture versus random augmentation on all 75 confirmation cases. Positive values favor weighted mixture; each point is one case, and diamonds show the mean with the deterministic 100,000-resample case-bootstrap 95\% interval. W/L gives weighted wins/losses (no ties). MSE is plotted as a reduction, so positive is better. Both pipelines use the same five case-stable trajectories and voxel-wise mean aggregation}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Weighted-mixture mean-$N=5$ examples at the lower empirical 10th, 50th, and 90th SSIM quantiles. Panels show voided input, prediction, observed T1n, paired zooms, and normalized absolute error. Cyan marks the full hole and dashed yellow the healthy scoring region; error is shown only there on a shared clipped scale. High-coverage axial slices are selected by mask geometry, independently of reconstruction error.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:qualitative-reconstructions}{{5}{9}{Weighted-mixture mean-$N=5$ examples at the lower empirical 10th, 50th, and 90th SSIM quantiles. Panels show voided input, prediction, observed T1n, paired zooms, and normalized absolute error. Cyan marks the full hole and dashed yellow the healthy scoring region; error is shown only there on a shared clipped scale. High-coverage axial slices are selected by mask geometry, independently of reconstruction error}{figure.5}{}}
